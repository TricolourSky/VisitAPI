<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VisitAPI</AssemblyName>
    <RootNamespace>VisitAPI</RootNamespace>
    <Version>1.3.3</Version>
    <EftDir Condition="'$(EftDir)' == ''">D:\EFT</EftDir>
    <Managed>$(EftDir)\EscapeFromTarkov_Data\Managed</Managed>
    <DlgSrc Condition="'$(DlgSrc)' == ''">..\..\VisitAPI Editor\src\VisitAPI.Dlg</DlgSrc>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="art\*.png" />
    <EmbeddedResource Include="art\audio\*.ogg" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(DlgSrc)\*.cs" LinkBase="Dialog\Shared" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(EftDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(EftDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(Managed)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.VideoModule" HintPath="$(Managed)\UnityEngine.VideoModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(Managed)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestModule" HintPath="$(Managed)\UnityEngine.UnityWebRequestModule.dll" Private="false" />
    <Reference Include="UnityEngine.UnityWebRequestAudioModule" HintPath="$(Managed)\UnityEngine.UnityWebRequestAudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(Managed)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(Managed)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(Managed)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="Unity.Postprocessing.Runtime" HintPath="$(Managed)\Unity.Postprocessing.Runtime.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(Managed)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="uLipSync.Runtime" HintPath="$(Managed)\uLipSync.Runtime.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="$(Managed)\Sirenix.Serialization.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(Managed)\Comfort.dll" Private="false" />
    <Reference Include="Comfort.Unity" HintPath="$(Managed)\Comfort.Unity.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(Managed)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="spt-common" HintPath="$(EftDir)\BepInEx\plugins\spt\spt-common.dll" Private="false" />
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build" Condition="Exists('$(EftDir)\BepInEx') And '$(SkipDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(EftDir)\BepInEx\plugins\VisitAPI" />
    <!-- 09-23 文件树整理：界面包的源文件住仓库 content\ui\（发布内容和代码分开），游戏里住 ui\（客户端 VisitPaths 先找 ui\，老的 bundles\ 还认） -->
    <Copy SourceFiles="..\content\ui\visitapi_chapterui.bundle" DestinationFolder="$(EftDir)\BepInEx\plugins\VisitAPI\ui" Condition="Exists('..\content\ui\visitapi_chapterui.bundle')" />
    <Copy SourceFiles="..\content\ui\visitapi_narrateloading.bundle" DestinationFolder="$(EftDir)\BepInEx\plugins\VisitAPI\ui" Condition="Exists('..\content\ui\visitapi_narrateloading.bundle')" />
    <Message Importance="high" Text="已部署: VisitAPI.dll → $(EftDir)\BepInEx\plugins\VisitAPI（界面包 → ui\）" />
  </Target>

</Project>
