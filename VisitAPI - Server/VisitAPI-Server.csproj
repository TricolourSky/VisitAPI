<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VisitAPI-Server</AssemblyName>
    <RootNamespace>VisitAPI.Server</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SPTServerDir Condition="'$(SPTServerDir)' == '' and Exists('D:\EFT\SPT\SPTarkov.Server.Core.dll')">D:\EFT\SPT</SPTServerDir>
    <SPTServerDir Condition="'$(SPTServerDir)' == '' and Exists('D:\SPT\SPT\SPTarkov.Server.Core.dll')">D:\SPT\SPT</SPTServerDir>
    <SPTServerDir Condition="'$(SPTServerDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\SPT</SPTServerDir>
    <SPTModDir Condition="'$(SPTModDir)' == '' and Exists('D:\EFT\SPT\user\mods\VisitAPI-Server')">D:\EFT\SPT\user\mods\VisitAPI-Server</SPTModDir>
    <SPTModDir Condition="'$(SPTModDir)' == '' and Exists('D:\SPT\SPT\user\mods\VisitAPI-Server')">D:\SPT\SPT\user\mods\VisitAPI-Server</SPTModDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SPTServerDir)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SPTServerDir)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SPTServerDir)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Reflection">
      <HintPath>$(SPTServerDir)\SPTarkov.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SPTServerDir)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToSPT" AfterTargets="Build" Condition="'$(SPTModDir)' != ''">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll"
          DestinationFolder="$(SPTModDir)"
          OverwriteReadOnlyFiles="true" />
    <!-- package.json -->
    <Copy SourceFiles="$(ProjectDir)package.json"
          DestinationFolder="$(SPTModDir)"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('$(ProjectDir)package.json')" />
    <!-- 同步 db/ 数据目录（任务 JSON + 本地化文件）-->
    <Exec Command="xcopy /y /e /i /q &quot;$(ProjectDir)db&quot; &quot;$(SPTModDir)\db&quot;"
          Condition="Exists('$(ProjectDir)db')" />
    <!-- 同步 images/ 目录（自定义任务图片）-->
    <MakeDir Directories="$(SPTModDir)\images\quest" Condition="!Exists('$(SPTModDir)\images\quest')" />
    <Exec Command="xcopy /y /e /i /q &quot;$(ProjectDir)images&quot; &quot;$(SPTModDir)\images&quot;"
          Condition="Exists('$(ProjectDir)images')" />
  </Target>
</Project>
