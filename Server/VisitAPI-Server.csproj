<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VisitAPI-Server</AssemblyName>
    <RootNamespace>VisitAPI.Server</RootNamespace>
    <Version>1.1.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 本机 SPT 服务端目录; 外部构建用 dotnet build -p:SptDir=<路径> 覆写 -->
    <SptDir Condition="'$(SptDir)' == ''">D:\EFT\SPT_Runtime</SptDir>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="SPTarkov.Server.Core" HintPath="$(SptDir)\SPTarkov.Server.Core.dll" Private="false" />
    <Reference Include="SPTarkov.DI" HintPath="$(SptDir)\SPTarkov.DI.dll" Private="false" />
    <Reference Include="SPTarkov.Common" HintPath="$(SptDir)\SPTarkov.Common.dll" Private="false" />
    <Reference Include="SPTarkov.Reflection" HintPath="$(SptDir)\SPTarkov.Reflection.dll" Private="false" />
    <Reference Include="SemanticVersioning" HintPath="$(SptDir)\SemanticVersioning.dll" Private="false" />
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build" Condition="Exists('$(SptDir)\user')">
    <ItemGroup>
      <DbFiles Include="db\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptDir)\user\mods\VisitAPI-Server" />
    <Copy SourceFiles="@(DbFiles)" DestinationFolder="$(SptDir)\user\mods\VisitAPI-Server\db\%(RecursiveDir)" />
    <Message Importance="high" Text="已部署: VisitAPI-Server.dll → $(SptDir)\user\mods\VisitAPI-Server" />
  </Target>

</Project>
